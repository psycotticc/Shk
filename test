local function createToggle(parent, name, yPos, settingKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -24, 0, 30)
    btn.Position = UDim2.new(0, 12, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
    btn.Text = "  " .. name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 85, 85)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}):Play()
        TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {Scale = 1.03}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {BackgroundColor3 = Color3.fromRGB(28, 28, 32)}):Play()
        TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {Scale = 1}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        TweenService:Create(scale, TweenInfo.new(0.08), {Scale = 0.95}):Play()
        task.delay(0.08, function()
            TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1}):Play()
        end)
        if Settings[settingKey] then
            btn.Text = "  " .. name .. ": ON"
            TweenService:Create(btn, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(100, 255, 140)}):Play()
        else
            btn.Text = "  " .. name .. ": OFF"
            TweenService:Create(btn, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 85, 85)}):Play()
        end
    end)
    return btn
end

