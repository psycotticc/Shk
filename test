local function isProtected(obj)
    if not obj then return true end
    local model = obj:FindFirstAncestorOfClass("Model")
    if model and (model:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(model)) then return true end
    if obj:IsA("Model") and (obj:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(obj)) then return true end
    local n = string.lower(obj.Name)
    if n:find("baseplate") or n:find("terrain") or n:find("spawn") then return true end
    if obj:IsA("Terrain") then return true end
    if obj:IsA("BasePart") and obj.Anchored and obj.Size.X > 80 and obj.Size.Z > 80 and math.abs(obj.Position.Y) < 8 then return true end
    return false
end

