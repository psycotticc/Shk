local function FirePrompt(prompt)
    if not prompt then return end
    pcall(function()
        fireproximityprompt(prompt)
    end)
end

local function EquipAndPut(toolName, prompt)
    if not AutoMS then return false end
    local tool = GetTool(toolName)
    if not tool then return false end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    hum:EquipTool(tool)
    task.wait(0.4)

    FirePrompt(prompt)
    task.wait(0.1)
    FirePrompt(prompt)
    task.wait(0.1)
    FirePrompt(prompt)

    task.wait(0.3)
    return true
end

local function FindNearestCookingPot()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, math.huge end

    local bestPrompt, bestDist = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Cooking Pot" then
            local prompt = obj:FindFirstChild("ProximityPrompt", true)
            if prompt and prompt:IsA("ProximityPrompt") then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local dist = (part.Position - hrp.Position).Magnitude
                    if dist < bestDist then
                        bestPrompt = prompt
                        bestDist = dist
                    end
                end
            end
        end
    end
    return bestPrompt, bestDist
end

local function DestroyPlatform()
    if stayConnection then
        stayConnection:Disconnect()
        stayConnection = nil
    end
    if currentPlatform then
        currentPlatform:Destroy()
        currentPlatform = nil
    end
    isProtecting = false
end

local function ReturnToOriginal()
    if not currentPlatform or not currentPlatform.Parent then
        DestroyPlatform()
        return
    end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetPos = originalPos or Vector3.new(currentPlatform.Position.X, originalY, currentPlatform.Position.Z)

    local tween = TweenService:Create(currentPlatform, TweenInfo.new(2.0, Enum.EasingStyle.Quad), {
        CFrame = CFrame.new(targetPos.X, targetPos.Y - 4.3, targetPos.Z)
    })
    tween:Play()
    tween.Completed:Wait()

    if hrp then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    DestroyPlatform()
    CurrentStatus = "Listo"
end

local function EnsurePlatform()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if currentPlatform and currentPlatform.Parent then return true end

    originalY = hrp.Position.Y
    originalPos = hrp.Position
    local pos = hrp.Position

    currentPlatform = Instance.new("Part")
    currentPlatform.Name = "FarmPlatform"
    currentPlatform.Size = Vector3.new(12, 1.5, 12)
    currentPlatform.Anchored = true
    currentPlatform.CanCollide = true
    currentPlatform.Material = Enum.Material.Neon
    currentPlatform.Color = Color3.fromRGB(80, 120, 255)
    currentPlatform.Transparency = 0.35
    currentPlatform.CFrame = CFrame.new(pos.X, pos.Y - 4, pos.Z)
    currentPlatform.Parent = workspace
    isProtecting = true

    stayConnection = RunService.Heartbeat:Connect(function()
        if hrp and hrp.Parent and currentPlatform and currentPlatform.Parent then
            local p = currentPlatform.Position
            hrp.CFrame = CFrame.new(p.X, p.Y + 4.3, p.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end)
    return true
end

local function GoDownAndUp(seconds)
    if not EnsurePlatform() then return end
    local px = currentPlatform.Position.X
    local pz = currentPlatform.Position.Z

    local down = TweenService:Create(currentPlatform, TweenInfo.new(2.2, Enum.EasingStyle.Quad), {
        CFrame = CFrame.new(px, SafeHeight, pz)
    })
    down:Play()
    down.Completed:Wait()

    if not AutoMS then ReturnToOriginal() return end

    local start = tick()
    while tick() - start < seconds do
        if not AutoMS then ReturnToOriginal() return end
        task.wait(0.1)
    end

    if not AutoMS then ReturnToOriginal() return end

    local up = TweenService:Create(currentPlatform, TweenInfo.new(2.0, Enum.EasingStyle.Quad), {
        CFrame = CFrame.new(px, originalY - 4.3, pz)
    })
    up:Play()
    up.Completed:Wait()
end

local function StartAutoMSLoop()
    task.spawn(function()
        while AutoMS do
            if not HasIngredients() then
                AutoMS = false
                AutoMSButton.Text = "Auto MS: OFF"
                TweenService:Create(AutoMSButton, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 85, 85)}):Play()
                ReturnToOriginal()
                CurrentStatus = "Sin ingredientes"
                break
            end

            local prompt, dist = FindNearestCookingPot()
            if not prompt or dist > 15 then
                CurrentStatus = "Acercate a la olla"
                task.wait(0.5)
                continue
            end

            CurrentStatus = "Poniendo Water..."
            EquipAndPut("Water", prompt)
            if not AutoMS then break end
            GoDownAndUp(18)
            if not AutoMS then break end

            CurrentStatus = "Poniendo Sugar..."
            EquipAndPut("Sugar Block", prompt)
            if not AutoMS then break end
            task.wait(1.3)
            if not AutoMS then break end

            CurrentStatus = "Poniendo Gelatin..."
            EquipAndPut("Gelatin", prompt)
            if not AutoMS then break end
            GoDownAndUp(43)
            if not AutoMS then break end

            CurrentStatus = "Usando Empty Bag..."
            local empty = GetTool("Empty Bag") or GetTool("Empty") or GetTool("Bag")
            if empty then
                EquipAndPut(empty.Name, prompt)
            end

            CurrentStatus = "Ciclo terminado"
            task.wait(1)
        end

        if isProtecting then
            ReturnToOriginal()
        end
        CurrentStatus = "Detenido"
    end)
end

