local function newDrawing(class, props)
    local obj = Drawing.new(class)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function createESP(player)
    if player == LocalPlayer then return end
    local data = {
        Box = newDrawing("Square", {Thickness = 1.2, Filled = false, Color = Color3.fromRGB(255,255,255), Visible = false}),
        Name = newDrawing("Text", {Size = 9, Center = true, Outline = true, OutlineColor = Color3.fromRGB(0,0,0), Color = Color3.fromRGB(255,255,255), Font = 2, Visible = false}),
        Distance = newDrawing("Text", {Size = 8, Center = true, Outline = true, OutlineColor = Color3.fromRGB(0,0,0), Color = Color3.fromRGB(180,180,180), Font = 2, Visible = false}),
        HealthBg = newDrawing("Square", {Thickness = 0, Filled = true, Color = Color3.fromRGB(12,12,12), Visible = false}),
        Health = newDrawing("Square", {Thickness = 0, Filled = true, Color = Color3.fromRGB(80,255,140), Visible = false}),
        Inventory = {}
    }
    for i = 1, 12 do
        data.Inventory[i] = newDrawing("Text", {
            Size = 8, Center = false, Outline = true,
            OutlineColor = Color3.fromRGB(0,0,0),
            Color = Color3.fromRGB(220,220,220), Font = 2, Visible = false
        })
    end
    ESP[player] = data
end

local function removeESP(player)
    local data = ESP[player]
    if data then
        data.Box:Remove() data.Name:Remove() data.Distance:Remove()
        data.HealthBg:Remove() data.Health:Remove()
        for _, v in pairs(data.Inventory) do v:Remove() end
        ESP[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

local function getBodyBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    if not hrp or not head then return nil end

    local topPos = head.Position + Vector3.new(0, head.Size.Y / 2 + 0.35, 0)
    local bottomPos = hrp.Position - Vector3.new(0, 3.0, 0)

    local top, topOn = Camera:WorldToViewportPoint(topPos)
    local bottom, bottomOn = Camera:WorldToViewportPoint(bottomPos)
    local center, centerOn = Camera:WorldToViewportPoint(hrp.Position)

    if not centerOn or top.Z <= 0 or bottom.Z <= 0 or center.Z <= 0 then
        return nil
    end

    local height = math.abs(bottom.Y - top.Y)
    height = math.clamp(height, 12, 220)

    local width = height * 0.48
    width = math.clamp(width, 8, 120)

    return {
        X = center.X - width / 2,
        Y = math.min(top.Y, bottom.Y),
        Width = width,
        Height = height,
        CenterX = center.X
    }
end

local function isSpecialWeapon(name)
    local lower = string.lower(name)
    if string.find(lower, "drum magazine") then
        return false
    end
    if string.find(lower, "drum") then return true end
    if string.find(lower, "tec%s*9") or string.find(lower, "tec9") then return true end
    if string.find(lower, "draco") or string.find(lower, "drac") then return true end
    if string.find(lower, "arp") then return true end
    if string.find(lower, "mcx") then return true end
    if string.find(lower, "plr%-16") or string.find(lower, "plr16") then return true end
    return false
end

local function getInventory(player)
    local counts = {}
    local equippedName = nil

    local function add(tool, isEquipped)
        if tool and tool:IsA("Tool") then
            local n = tool.Name
            counts[n] = (counts[n] or 0) + 1
            if isEquipped then
                equippedName = n
            end
        end
    end

    if player.Character then
        for _, v in pairs(player.Character:GetChildren()) do
            add(v, true)
        end
    end
    if player:FindFirstChild("Backpack") then
        for _, v in pairs(player.Backpack:GetChildren()) do
            add(v, false)
        end
    end

    local items = {}
    for name, amount in pairs(counts) do
        table.insert(items, {
            Name = name,
            Amount = amount,
            Equipped = (name == equippedName)
        })
    end
    return items
end

RunService.RenderStepped:Connect(function()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESP) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if not (char and hum and hrp and hum.Health > 0) then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.HealthBg.Visible = false
            data.Health.Visible = false
            for _, v in pairs(data.Inventory) do v.Visible = false end
            continue
        end

        local dist = 0
        if myRoot then
            dist = (myRoot.Position - hrp.Position).Magnitude
        end
        if dist > 500 then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.HealthBg.Visible = false
            data.Health.Visible = false
            for _, v in pairs(data.Inventory) do v.Visible = false end
            continue
        end

        local box = getBodyBox(char)
        if not box or box.Width < 4 or box.Height < 8 then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.HealthBg.Visible = false
            data.Health.Visible = false
            for _, v in pairs(data.Inventory) do v.Visible = false end
            continue
        end

        local x, y = box.X, box.Y
        local width, height = box.Width, box.Height
        local centerX = box.CenterX

        if Settings.Box then
            data.Box.Size = Vector2.new(width, height)
            data.Box.Position = Vector2.new(x, y)
            data.Box.Visible = true
        else
            data.Box.Visible = false
        end

        if Settings.Name then
            data.Name.Text = player.Name
            data.Name.Position = Vector2.new(centerX, y - 12)
            data.Name.Visible = true
        else
            data.Name.Visible = false
        end

        if Settings.Distance then
            data.Distance.Text = math.floor(dist) .. " studs"
            data.Distance.Position = Vector2.new(centerX, y + height + 2)
            data.Distance.Visible = true
        else
            data.Distance.Visible = false
        end

        if Settings.HealthBar then
            local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barW = 1.5
            data.HealthBg.Size = Vector2.new(barW + 0.7, height)
            data.HealthBg.Position = Vector2.new(x - 3, y)
            data.HealthBg.Visible = true
            data.Health.Size = Vector2.new(barW, height * hp)
            data.Health.Position = Vector2.new(x - 2.65, y + height * (1 - hp))
            if hp > 0.65 then
                data.Health.Color = Color3.fromRGB(90, 255, 145)
            elseif hp > 0.35 then
                data.Health.Color = Color3.fromRGB(255, 215, 60)
            else
                data.Health.Color = Color3.fromRGB(255, 60, 60)
            end
            data.Health.Visible = true
        else
            data.HealthBg.Visible = false
            data.Health.Visible = false
        end

        if Settings.Inventario then
            local items = getInventory(player)
            for i, d in pairs(data.Inventory) do
                if items[i] then
                    local text = items[i].Name .. " (" .. items[i].Amount .. ")"
                    if items[i].Equipped then
                        text = text .. " (equiped)"
                    end
                    d.Text = text

                    if isSpecialWeapon(items[i].Name) then
                        d.Color = Color3.fromRGB(0, 255, 180)
                    else
                        d.Color = Color3.fromRGB(220, 220, 220)
                    end

                    d.Position = Vector2.new(x + width + 5, y + (i - 1) * 11)
                    d.Visible = true
                else
                    d.Visible = false
                end
            end
        else
            for _, v in pairs(data.Inventory) do v.Visible = false end
        end
    end
end)

else
    game.Players.LocalPlayer:Kick("(incorrect Key)")
end
